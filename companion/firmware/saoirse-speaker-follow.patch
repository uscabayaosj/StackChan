+        // another peripheral has the bus, try its encoder again before recapturing.
+        bool measured=pose(after);
+        if (!measured && allowed(j)) { pause(30); measured=pose(after); }
+        if (!allowed(j)) break;
+        if (!measured || !near(capture,after,25)) {
+            previous={};
+            if (++rejected>=3) break;
+            pause(45);
+            continue;
+        }
+        if (consistent(previous,f) && near(previousPose,capture,25)) {
