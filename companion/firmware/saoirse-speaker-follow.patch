+        const float expectedInView=expected-(capture.yaw-anchor.yaw)/10.f;
+        const Face f=detect(detector,rgb,expectedInView,j.bearing.reliable,faces,viewX,viewY,viewWidth,viewHeight,inputWidth,inputHeight);
+        maxFaces=std::max(maxFaces,faces);
+        if (!allowed(j)) break;
