+# espressif/human_face_detect 0.2.1 and esp-dl 3.1.4 are pinned in main/idf_component.yml.
+# A CoreS3 desk test identified missed MSR proposals at the default threshold:
+# https://github.com/7H3-CH053N/StackChan-CustomFW/blob/main/firmware/xiaozhi-esp32.patch#L365-L371
+# Only broaden stage-one proposals here. Stage two still verifies each real face.
+idf_component_get_property(face_component_dir espressif__human_face_detect COMPONENT_DIR)
+idf_component_get_property(face_component_lib espressif__human_face_detect COMPONENT_LIB)
+set(face_overlay_dir "${CMAKE_BINARY_DIR}/stackchan-overlays")
+set(face_source "${face_component_dir}/human_face_detect.cpp")
+set(face_patch "${CMAKE_CURRENT_SOURCE_DIR}/patches/human-face-detect-msr.patch")
+file(MAKE_DIRECTORY "${face_overlay_dir}")
+execute_process(
+    COMMAND patch --batch -F 0 -o "${face_overlay_dir}/human_face_detect.cpp.new" "${face_source}" "${face_patch}"
+    RESULT_VARIABLE face_patch_status OUTPUT_QUIET ERROR_VARIABLE face_patch_error)
+if(NOT face_patch_status EQUAL 0)
+    message(FATAL_ERROR "StackChan face detector overlay could not be applied: ${face_patch_error}")
+endif()
+configure_file("${face_overlay_dir}/human_face_detect.cpp.new" "${face_overlay_dir}/human_face_detect.cpp" COPYONLY)
+get_target_property(face_sources ${face_component_lib} SOURCES)
+list(FILTER face_sources EXCLUDE REGEX "(^|/)human_face_detect\\.cpp$")
+set_property(TARGET ${face_component_lib} PROPERTY SOURCES ${face_sources} "${face_overlay_dir}/human_face_detect.cpp")
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${face_source}" "${face_patch}")
