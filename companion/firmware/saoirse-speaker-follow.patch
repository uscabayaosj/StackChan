+        if (faces && !f.size) break;
+        if (faces) { misses=0; pause(15); continue; }
+        ++misses;
+        // After a wide-field miss, examine original sensor pixels. A candidate
+        // gets a second fresh frame in the same crop before any servo movement.
+        if (j.extended && !zoom) { zoom=true; pause(10); continue; }
+        zoom=false;
+        if (j.extended && misses<2) continue;
+        if (seen || !j.search) break;
+        if (search>=plan.count) {
+            // From the last front-facing view, inspect the edges at native
+            // sensor resolution without spending another turn on a missed face.
+            if (!j.extended || edgeChecks>=2 || std::abs(capture.yaw)>80) break;
+            ++edgeChecks; zoom=true; previous={}; continue;
+        }
+        const auto view=plan.views[search];
+        const Pose target{view.yaw,view.pitch};
+        if (!move(j,target,&anchor)) break;
+        if (!firstTurn) firstTurn=nowMs()-j.start;
+        ++search; misses=0; previous={};
+        ESP_LOGI(tag,"checking view at yaw=%d pitch=%d",target.yaw/10,target.pitch/10);
+        settle(j,target);
+    }
+    const bool returning=!seen && releaseProbe(j,true);
+    explicit_bzero(rgb,j.extended ? imageBytes : width*height*3);
+    Pose final{};
+    // Return movement is asynchronous. An encoder sample taken here would
+    // still describe the last probe while the head travels back to the anchor.
+    const bool measured=replyGate.accepts(j.turn) && !returning && pose(final);
+    ESP_LOGI(tag,"local check: frames=%d probes=%d confirmed=%d corrections=%d candidates=%d light=%d "
+                 "final_yaw=%d final_pitch=%d crop_frames=%d queued_ms=%u first_face_ms=%d elapsed_ms=%u "
+                 "first_turn_ms=%d rejected_frames=%d exposure_frames=%d anchor_yaw=%d anchor_pitch=%d returning=%d",
+             frames,search,int(seen),fixes,maxFaces,light,
+             measured ? final.yaw/10 : -999, measured ? final.pitch/10 : -999,zoomFrames,
+             unsigned(dequeued-j.start),firstFace ? int(firstFace) : -1,unsigned(nowMs()-j.start),
+             firstTurn ? int(firstTurn) : -1,rejected,exposureFrames,anchor.yaw/10,anchor.pitch/10,int(returning));
+}
+void work(void*)
+{
+    auto* rgb=static_cast<uint8_t*>(heap_caps_malloc(imageBytes,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT));
+    if (!rgb) { ESP_LOGE(tag,"no external camera scratch memory"); }
+    HumanFaceDetect detector;
+    ESP_LOGI(tag,"local neural detector ready; internal free=%u",unsigned(heap_caps_get_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT)));
+    for (;;) {
+        ulTaskNotifyTake(pdTRUE,portMAX_DELAY);
+        Job j{};
+        {
+            std::lock_guard<std::mutex> lock(queueMutex);
+            if (!hasJob) continue;
+            j=pending; hasJob=false; running=true;
+        }
+        if (rgb) follow(j,detector,rgb);
+        { std::lock_guard<std::mutex> lock(queueMutex); running=false; }
+    }
+}
+}
+void Prepare()
+{
+    std::lock_guard<std::mutex> lock(queueMutex);
+    if (!worker && xTaskCreateWithCaps(work,"face_center",10000,nullptr,3,&worker,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT)!=pdPASS) {
+        worker=nullptr; ESP_LOGW(tag,"neural worker unavailable");
+    }
+}
+void PauseForReply()
+{
+    replyGate.pause();
+}
+void StartListeningTurn()
+{
+    replyGate.resume();
+}
+void MotionTick()
+{
+    // Called under the existing servo lock; never queue behind inference.
+    if (!provisional.id) return;
+    if (provisional.epoch!=manualEpoch.load() || provisional.id==committedJob.load()) { provisional={}; return; }
+    if (replyGate.accepts(provisional.turn) && int32_t(nowMs()-provisional.deadline)<0) return;
+    if (!GetStackChan().motion().isModifyLocked()) drive(provisional.anchor);
+    provisional={};
+}
+void ManualOverride() {
+    manualEpoch.fetch_add(1); manualTime.store(nowMs()); lastConfirmed.store(0);
+    speaker_tracking::OnVisualMovement();
+}
+bool ConfirmedRecently(uint32_t maxAgeMs) { auto t=lastConfirmed.load(); return t && nowMs()-t<maxAgeMs; }
+bool Request(speaker_tracking::Bearing bearing, bool wake, bool search, bool explicitRequest)
+{
+    const auto now=nowMs(), last=manualTime.load();
+    if (last && now-last<5500 && !wake && !explicitRequest) return false;
+    std::lock_guard<std::mutex> lock(queueMutex);
+    const auto turn=replyGate.turn();
+    if (!worker || !replyGate.accepts(turn)) return false;
+    const auto epoch=manualEpoch.load();
+    const bool active=(running || hasJob) && pending.epoch==epoch && pending.turn==turn && now-pending.start<lifetime;
+    if (active && !wake && !explicitRequest) {
+        if (pending.extended || !speaker_tracking::replacesActiveLook(pending.bearing,pending.search,bearing,search)) return true;
+        // Upgrading a view-only check without new acoustic evidence can reuse its bearing.
+        if (!bearing.reliable) bearing=pending.bearing;
+    }
+    const auto id=latestJob.fetch_add(1)+1;
+    pending={now,epoch,id,turn,bearing,wake,search,explicitRequest};
+    hasJob=true; xTaskNotifyGive(worker);
+    return true;
+}
+}
