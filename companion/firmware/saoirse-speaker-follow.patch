+#pragma once
+
+#include "speaker_tracking.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstddef>
+
+namespace speaker_tracking {
+
+constexpr size_t kWindowSamples = 480;  // 20 ms at 24 kHz
+constexpr int kMaxLag = 5;
+constexpr int kSearchLag = kMaxLag + 2;  // Detect peaks outside the microphone baseline.
+using MicWindow = std::array<int16_t, kWindowSamples>;
+
+inline Bearing EstimateBearing(const MicWindow& first, const MicWindow& second)
+{
+    std::array<float, 2 * kSearchLag + 1> scores{};
+    int best = kSearchLag;
+    float bestScore = -1;
+    for (int lag = -kSearchLag; lag <= kSearchLag; ++lag) {
+        float cross = 0, firstEnergy = 0, secondEnergy = 0;
+        for (int i = kSearchLag + 2; i < static_cast<int>(kWindowSamples) - kSearchLag; i += 2) {
+            // Two-sample difference suppresses rumble and DC offset.
+            const float a = first[i] - first[i - 2];
+            const float b = second[i + lag] - second[i + lag - 2];
+            cross += a * b;
+            firstEnergy += a * a;
+            secondEnergy += b * b;
+        }
+        constexpr float kMinEnergy = 35.f * 35.f * ((kWindowSamples - 2 * kSearchLag - 2) / 2);
+        if (std::min(firstEnergy, secondEnergy) < kMinEnergy ||
+            std::min(firstEnergy, secondEnergy) * 20.f < std::max(firstEnergy, secondEnergy)) return {};
+        const int index = lag + kSearchLag;
+        scores[index] = cross / std::sqrt(firstEnergy * secondEnergy);
+        if (scores[index] > bestScore) {
+            bestScore = scores[index];
+            best = index;
+        }
+    }
+    if (bestScore < 0.55f || std::abs(best - kSearchLag) > kMaxLag) return {};
+    for (int index = 0; index < static_cast<int>(scores.size()); ++index) {
+        if (std::abs(index - best) > 1 && scores[index] > bestScore - 0.04f) return {};
+    }
+    float lag = static_cast<float>(best - kSearchLag);
+    if (best > 0 && best + 1 < static_cast<int>(scores.size())) {
+        const float left = scores[best - 1], right = scores[best + 1];
+        const float curvature = left + right - 2 * bestScore;
+        if (curvature < -0.001f) {
+            lag += std::clamp(0.5f * (left - right) / curvature, -0.5f, 0.5f);
+        }
+    }
+    return {lag, std::abs(lag) <= kMaxLag + 0.35f};
+}
+
+// A short majority and its median reject isolated echoes, including an
+// occasional confident outlier on the same side as the speaker.
+struct LagVotes {
+    std::array<float, 16> lags{};
+    size_t count = 0;
+    void Add(float lag) {
+        if (count < lags.size()) lags[count++] = lag;
+    }
+    speaker_tracking::Bearing consensus(float deadband, unsigned minimum) const {
+        std::array<float, 16> sorted = lags;
+        std::sort(sorted.begin(), sorted.begin() + count);
+        size_t low = 0;
+        while (low < count && sorted[low] < -deadband) ++low;
+        size_t high = count;
+        while (high > 0 && sorted[high - 1] > deadband) --high;
+        const size_t positive = count - high;
+        const size_t frontal = high - low;
+        if (frontal >= minimum && 3 * frontal >= 2 * count) return {0, true};
+        const bool left = low > positive;
+        const size_t votes = left ? low : positive;
+        if (votes < minimum || 3 * votes < 2 * count) return {};
+        const size_t start = left ? 0 : high;
+        return {(sorted[start+(votes-1)/2] + sorted[start+votes/2]) * .5f, true};
+    }
+};
+
+// Near center this board and room can produce delays up to 1.2 samples.
+constexpr float kFrontalLag = 1.35f;
+constexpr int kUnknownAlignment = 99;
+
+inline bool differentDirection(float first, float second)
+{
+    // Near the end of the microphone baseline, a small delay change spans
+    // a larger angle. Require both angular separation and a measurable delay.
+    if (std::abs(first-second)<1.15f) return false;
+    auto angle=[](float lag) { return std::asin(std::clamp(lag/4.f,-1.f,1.f)); };
+    return std::abs(angle(first)-angle(second))>.38f; // about 22 degrees
+}
+
+// A view-only check can share any current camera job. Only a full search
+// can promote a check or redirect an active search to a new speaker.
+inline bool replacesActiveLook(Bearing active, bool activeSearch, Bearing incoming, bool incomingSearch)
+{
+    if (!incomingSearch) return false;
+    if (!activeSearch) return true;
+    return incoming.reliable && (!active.reliable || differentDirection(active.lag,incoming.lag));
+}
+
