+#include "private_include/esp_video.h"
+#include "freertos/FreeRTOS.h"
+
+static uint8_t clipped(int x) { return x < 0 ? 0 : x > 255 ? 255 : (uint8_t)x; }
+
+static inline void store_rgb(uint8_t* pixel, int y, int cb, int cr)
+{
+    const int luminance = 298 * (y - 16);
+    cb -= 128;
+    cr -= 128;
+    pixel[0] = clipped((luminance + 409*cr + 128) >> 8);
+    pixel[1] = clipped((luminance - 100*cb - 208*cr + 128) >> 8);
+    pixel[2] = clipped((luminance + 516*cb + 128) >> 8);
+}
+
+static void sample_view(const uint8_t* source, unsigned stride, uint8_t* output,
+                        unsigned w, unsigned h, unsigned left, unsigned top,
+                        unsigned source_w, unsigned source_h)
+{
+    // The normal 320x240 sensor frame is reduced to 160x120. Average each
+    // complete YUYV block, including both chroma rows, before converting it.
+    if (source_w == 2*w && source_h == 2*h && !(left & 1u)) {
+        for (unsigned y = 0; y < h; ++y) {
+            const uint8_t* a = source + (top + 2*y)*stride + 2*left;
+            const uint8_t* b = a + stride;
+            for (unsigned x = 0; x < w; ++x, a += 4, b += 4, output += 3) {
+                store_rgb(output, (a[0]+a[2]+b[0]+b[2]+2)/4,
+                          (a[1]+b[1]+1)/2, (a[3]+b[3]+1)/2);
+            }
+        }
+        return;
+    }
+
+    const bool native = source_w == w && source_h == h;
+    for (unsigned y = 0; y < h; ++y) {
+        const unsigned sy = top + (native ? y : (2*y+1)*source_h/(2*h));
+        const uint8_t* row = source + sy*stride;
+        for (unsigned x = 0; x < w; ++x, output += 3) {
+            const unsigned sx = left + (native ? x : (2*x+1)*source_w/(2*w));
+            const uint8_t* pair = row + (sx & ~1u)*2;
+            store_rgb(output, pair[(sx & 1u)*2], pair[1], pair[3]);
+        }
+    }
+}
+
+// Region coordinates are in the full tracking image (w x h). Sample the
+// original sensor buffer directly so a cropped view retains native detail.
+bool read_fresh_dvp_rgb_region(uint8_t* output, unsigned w, unsigned h, unsigned sw, unsigned sh,
+                               unsigned x, unsigned y, unsigned view_w, unsigned view_h)
+{
+    struct esp_video* video = esp_video_device_get_object("DVP");
+    if (!video || !output || !w || !h || w > sw || h > sh || (sw & 1u) ||
