+#pragma once
+#include "face_aim.h"
+#include "human_face_detect.hpp"
+
+namespace face_aim {
+inline unsigned pixelLuma(const uint8_t* pixel)
+{
+    return (77*pixel[0]+150*pixel[1]+29*pixel[2]+128) >> 8;
+}
+
+struct Exposure {
+    unsigned mean;
+    bool liftedShadows;
+};
+
+inline Exposure compensateExposure(uint8_t* rgb, int inputWidth, int inputHeight)
+{
+    // A coarse sample estimates the dark pixels in a backlit view. A bounded
+    // shadow curve lifts detail while leaving the brightest parts of the frame.
+    std::array<unsigned,16> bins{};
+    unsigned sum=0, samples=0;
+    for (int y=4; y<inputHeight; y+=8) for (int x=4; x<inputWidth; x+=8) {
+        const unsigned luma=pixelLuma(rgb+3*(y*inputWidth+x));
+        ++bins[luma/16];
+        sum+=luma;
+        ++samples;
+    }
+    if (!samples) return {};
+    const unsigned mean=sum/samples;
+    unsigned quartile=0, below=0;
+    while (quartile<15 && (below+=bins[quartile])*4<samples) ++quartile;
+    if (mean>=145 || quartile>=4) return {mean,false};
+
+    const int strength=std::clamp(72-int(quartile)*16,24,72);
+    std::array<uint8_t,256> lift{};
+    for (unsigned luma=0; luma<lift.size(); ++luma) {
+        lift[luma]=uint8_t((strength*std::min(luma,64u)*(255-luma)) >> 14);
+    }
+    for (int i=0; i<inputWidth*inputHeight; ++i) {
+        auto* pixel=rgb+3*i;
+        const unsigned delta=lift[pixelLuma(pixel)];
+        for (int channel=0; channel<3; ++channel) {
+            pixel[channel]=uint8_t(std::min(255u,pixel[channel]+delta));
+        }
+    }
+    return {mean,true};
+}
+
+inline Face detect(HumanFaceDetect& detector, uint8_t* rgb, float expected, bool hasBearing, int& count,
+                   int viewX=0, int viewY=0, int viewWidth=width, int viewHeight=height,
+                   int inputWidth=width, int inputHeight=height)
+{
+    dl::image::img_t image{};
+    image.data=rgb;
+    image.width=inputWidth;
+    image.height=inputHeight;
+    image.pix_type=dl::image::DL_IMAGE_PIX_TYPE_RGB888;
+    Candidates candidates;
+    const float scaleX = static_cast<float>(viewWidth)/inputWidth;
+    const float scaleY = static_cast<float>(viewHeight)/inputHeight;
+    for (const auto& result : detector.run(image)) {
+        if (result.box.size() < 4) continue;
+        const auto& b=result.box;
+        const int w=b[2]-b[0], h=b[3]-b[1];
+        if (w<=0 || h<=0 || std::max(w,h)<10) continue;
+        // Compare acoustic direction and consecutive sightings in full-view
+        // coordinates even when the neural detector saw a native sensor crop.
+        const float x = viewX + .5f*(b[0]+b[2])*scaleX;
+        const float y = viewY + .5f*(b[1]+b[3])*scaleY;
+        candidates.add({x,y,std::max(w*scaleX,h*scaleY)},expected);
+    }
+    count=candidates.count;
+    return candidates.choose(hasBearing);
+}
+}
