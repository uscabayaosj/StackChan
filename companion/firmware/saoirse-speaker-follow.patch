+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+
+namespace face_aim {
+constexpr int width = 160, height = 120;
+struct InputSize { int width, height; };
+constexpr InputSize detectorInputSize(bool extended, bool crop)
+{
+    return extended && !crop ? InputSize{2*width,2*height} : InputSize{width,height};
+}
+
+// An exposure belongs to the listening turn in which it was requested.
+// An odd generation blocks new requests; resuming starts a new generation.
+class ReplyGate {
+public:
+    uint32_t turn() const { return generation.load(); }
+    bool accepts(uint32_t turn) const { return !(turn & 1u) && turn==generation.load(); }
+    void pause() { generation.fetch_or(1u); }
+    void resume() {
+        auto blocked=generation.load();
+        if (blocked & 1u) generation.compare_exchange_strong(blocked,blocked+1u);
+    }
+private:
+    std::atomic<uint32_t> generation{0};
+};
+struct Face { float x = 0, y = 0, size = 0; };
+inline bool consistent(Face a, Face b)
+{
+    return a.size > 0 && b.size > 0 &&
+        std::hypot(a.x-b.x,a.y-b.y) <= std::max(8.f, std::min(a.size,b.size)*.45f) &&
+        std::min(a.size,b.size) >= .6f*std::max(a.size,b.size);
+}
+inline int correction(float offset, int dimension, float field, int limit)
+{
+    if (std::abs(offset) <= dimension*.06f) return 0;
+    return std::clamp(static_cast<int>(std::lround(offset*field*.83f/dimension)), -limit, limit);
+}
+inline float bearingDegrees(float lag) { return -std::asin(std::clamp(lag/4.f,-1.f,1.f))*57.29578f; }
+
+// All planner positions are absolute servo angles, in tenths of a degree.
+struct SearchView { int yaw, pitch; };
+struct SearchPlan {
+    std::array<SearchView,3> views{};
+    int count=0;
+};
+
+inline SearchPlan planSearch(int anchorYaw, int anchorPitch, int lastPitch,
+                             float bearing, bool hasBearing, bool extended=true)
+{
+    constexpr int sideYaw=220;
+    constexpr int maxPitchStep=240;
+    const int pitch=std::clamp(std::clamp(lastPitch,anchorPitch-maxPitchStep,anchorPitch+maxPitchStep),30,700);
+    const int secondPitch=std::abs(lastPitch-pitch)>=120
+        ? std::clamp(std::clamp(lastPitch,pitch-maxPitchStep,pitch+maxPitchStep),30,700)
+        : std::clamp(pitch+(pitch<270 ? 160 : -160),30,700);
+    const SearchView anchor{anchorYaw,anchorPitch};
+    SearchPlan plan;
+    // Nearby headings have substantial optical overlap. A different tilt still
+    // counts as a new view, e.g. when the robot is on a desk below the speaker.
+    auto overlaps=[](SearchView a, SearchView b) {
+        return std::abs(a.yaw-b.yaw)<160 && std::abs(a.pitch-b.pitch)<120;
+    };
+    auto add=[&](SearchView view) {
+        if (plan.count==(extended ? int(plan.views.size()) : 2) || overlaps(view,anchor)) return;
+        for (int i=0;i<plan.count;++i) if (overlaps(view,plan.views[i])) return;
+        plan.views[plan.count++]=view;
+    };
+    if (hasBearing && std::isfinite(bearing) && std::abs(bearing)<=90.f) {
+        const int predicted=anchorYaw+int(std::lround(bearing*10));
+        // An out-of-travel source is not a reason to drive into the end stop.
+        // Scan the front sector if the projected heading is unreachable.
+        if (std::abs(predicted)<=900) {
+            const int nearestSide=predicted<0 ? -sideYaw : sideYaw;
+            const int hint=std::abs(predicted-nearestSide)<160 ? nearestSide : predicted;
+            add({hint,pitch});
+        }
+    }
+    // At the edge, approach the nearer side first and then cross straight ahead.
+    // From a normal conversational pose, check the opposite speaker first.
+    const int current=plan.count ? plan.views[0].yaw : anchorYaw;
+    const int side=current<0 ? -1 : 1;
+    const int firstSide=std::abs(current)>420 ? side : -side;
+    add({firstSide*sideYaw,pitch});
+    add({-firstSide*sideYaw,pitch});
+    if (extended) add({0,secondPitch});
+    return plan;
+}
+
+struct Candidates {
+    int count = 0;
+    float bestError = 1000, secondError = 1000;
+    Face best{};
+    void add(Face f, float expected)
+    {
+        ++count;
+        float error=std::abs((f.x/width-.5f)*62.f-expected);
+        if (error < bestError) { secondError=bestError; bestError=error; best=f; }
+        else secondError=std::min(secondError,error);
+    }
+    Face choose(bool bearing) const
+    {
+        if (count == 1) return best;
+        return bearing && bestError < 19 && secondError-bestError > 9 ? best : Face{};
+    }
+};
+}
