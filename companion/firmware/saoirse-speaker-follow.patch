+            const float error=std::hypot(dx*62/width,dy*47/height);
+            const int dyaw=correction(dx,width,62,16), dpitch=correction(dy,height,47,10);
+            if (!seen) { committedJob.store(j.id); releaseProbe(j,false); firstFace=nowMs()-j.start; }
+            seen=true; lastFacePitch=capture.pitch; lastConfirmed.store(nowMs());
