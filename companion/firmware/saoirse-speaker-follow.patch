+#include <atomic>
+#include <mutex>
+#include <strings.h>
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_lvgl_port.h>
+#include "speaker_bearing.h"
+#include <esp_timer.h>
+#include <freertos/idf_additions.h>
+
+namespace face_centering {
+namespace {
+using namespace face_aim;
+constexpr char tag[]="FaceCenter";
+// Keep the native sensor detail for the second-stage landmark check.
+constexpr int nativeWidth=2*width, nativeHeight=2*height;
+constexpr size_t imageBytes=nativeWidth*nativeHeight*3;
+constexpr uint32_t lifetime = 6500;
+struct Job { uint32_t start, epoch, id, turn; speaker_tracking::Bearing bearing; bool wake, search, extended; };
+struct Pose { int yaw, pitch; };
+std::mutex queueMutex;
+TaskHandle_t worker=nullptr;
+Job pending{};
+bool hasJob=false, running=false;
+int lastFacePitch=150;  // Worker-owned, in tenths of a degree.
+std::atomic<uint32_t> manualEpoch{0}, manualTime{0}, lastConfirmed{0}, latestJob{0}, committedJob{0};
+ReplyGate replyGate;
+// These fields are accessed only while holding the LVGL/servo bus lock. The
+// regular motion tick can restore a temporary pose even if inference is delayed.
+struct ProvisionalPose { Pose anchor{}; uint32_t id=0, epoch=0, turn=0, deadline=0; } provisional;
+class ServoLock {
+public:
+    ServoLock() : acquired(lvgl_port_lock(35)) {}
+    ~ServoLock() { if (acquired) lvgl_port_unlock(); }
+    const bool acquired;
+};
+uint32_t nowMs() { return static_cast<uint32_t>(esp_timer_get_time()/1000); }
+void pause(int ms) { vTaskDelay(pdMS_TO_TICKS(ms)); }
+bool allowed(const Job& j)
+{
+    const auto state=Application::GetInstance().GetDeviceState();
+    const auto age=nowMs()-j.start;
+    return replyGate.accepts(j.turn) && latestJob.load()==j.id && manualEpoch.load()==j.epoch && age < lifetime &&
+        (state==kDeviceStateListening || (j.wake && (state==kDeviceStateConnecting || (state==kDeviceStateIdle && age<350))));
+}
+bool pose(Pose& p)
+{
+    ServoLock guard;
+    if (!guard.acquired) return false;
+    auto& m=GetStackChan().motion();
+    if (m.isModifyLocked()) return false;
+    return m.yawServo().readMeasuredAngle(p.yaw) && m.pitchServo().readMeasuredAngle(p.pitch);
+}
+bool near(Pose a, Pose b, int tolerance)
+{
+    return std::abs(a.yaw-b.yaw)<=tolerance && std::abs(a.pitch-b.pitch)<=tolerance;
+}
+void drive(Pose target)
+{
+    auto& motion=GetStackChan().motion();
+    motion.yawServo().moveWithSpeed(target.yaw,390);
+    motion.pitchServo().moveWithSpeed(target.pitch,300);
+    speaker_tracking::OnVisualMovement();
+}
+bool move(const Job& j, Pose target, const Pose* returnTo=nullptr)
+{
+    ServoLock guard;
+    if (!guard.acquired || !allowed(j) || GetStackChan().motion().isModifyLocked()) return false;
+    if (returnTo) {
+        // A newer bearing can interrupt an exploratory turn. Carry the original
+        // return pose forward until a face is confirmed or the search ends.
+        const bool inherit=provisional.id && provisional.epoch==j.epoch && provisional.turn==j.turn &&
+                           provisional.id!=committedJob.load();
+        provisional={inherit ? provisional.anchor : *returnTo,j.id,j.epoch,j.turn,j.start+lifetime};
+    }
+    drive(target);
+    return true;
+}
+void settle(const Job& j,Pose target)
+{
+    const auto start=nowMs();
+    unsigned settled=0;
+    while (allowed(j) && nowMs()-start<750) {
+        pause(45);
+        if (!allowed(j)) break;
+        Pose current{};
+        if (pose(current) && near(current,target,22)) {
+            if (++settled>=2) break;
+        } else settled=0;
+    }
+}
+bool releaseProbe(const Job& j,bool restore)
+{
+    ServoLock guard;
+    if (!guard.acquired || provisional.id!=j.id) return false;
+    if (restore && latestJob.load()!=j.id && replyGate.accepts(j.turn)) return false;
+    const bool returning=restore && manualEpoch.load()==j.epoch && !GetStackChan().motion().isModifyLocked();
+    if (returning) drive(provisional.anchor);
+    provisional={};
+    return returning;
+}
+void follow(const Job& j,HumanFaceDetect& detector,uint8_t* rgb)
+{
+    auto* camera=hal_bridge::board_get_camera();
+    Pose anchor{};
+    const auto dequeued=nowMs();
+    if (!allowed(j) || !camera) return;
+    while (!pose(anchor)) {
+        if (!allowed(j) || nowMs()-dequeued>=250) {
+            ESP_LOGW(tag,"could not measure initial pose");
+            return;
+        }
+        pause(25);
+    }
+    {
+        ServoLock guard;
+        if (guard.acquired && provisional.id && provisional.epoch==j.epoch && provisional.turn==j.turn &&
+            provisional.id!=committedJob.load()) {
+            provisional.id=j.id;
+            provisional.deadline=j.start+lifetime;
+        }
+    }
+    const bool directional=j.bearing.reliable && std::abs(j.bearing.lag)>speaker_tracking::kFrontalLag;
+    const float expected=directional ? bearingDegrees(j.bearing.lag) : 0;
+    const auto plan=planSearch(anchor.yaw,anchor.pitch,lastFacePitch,expected,directional,j.extended);
+    uint32_t firstFace=0, firstTurn=0;
+    int rejected=0;
+    bool zoom=false;
+    int zoomFrames=0, edgeChecks=0, light=-1, exposureFrames=0;
+    Face previous{};
+    Pose previousPose{};
+    int search=0, misses=0, fixes=0, frames=0, maxFaces=0;
+    bool seen=false;
+    float previousError=1000;
+    while (allowed(j) && frames < (j.extended ? 26 : 10)) {
+        Pose capture{}, after{};
+        if (!pose(capture)) { pause(35); continue; }
+        const int viewWidth=zoom ? width/2 : width, viewHeight=zoom ? height/2 : height;
+        int viewX=(width-viewWidth)/2;
+        const int viewY=(height-viewHeight)/2;
+        if (zoom && edgeChecks) {
+            const bool rightFirst=directional ? expected>0 : plan.views[0].yaw>0;
+            const bool right=edgeChecks==1 ? rightFirst : !rightFirst;
+            viewX=right ? width-viewWidth : 0;
+        }
+        const auto [inputWidth,inputHeight]=detectorInputSize(j.extended,zoom);
+        if (!allowed(j)) break;
+        if (!camera->TryFaceRgb(rgb,inputWidth,inputHeight,viewX*inputWidth/width,viewY*inputHeight/height,
+                                viewWidth*inputWidth/width,viewHeight*inputHeight/height)) { pause(30); continue; }
+        if (!allowed(j)) break;
+        ++frames;
+        if (zoom) ++zoomFrames;
+        const auto exposure=compensateExposure(rgb,inputWidth,inputHeight);
+        light=int(exposure.mean);
+        exposureFrames+=exposure.liftedShadows;
+        if (!allowed(j)) break;
