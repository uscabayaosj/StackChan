+            if (!move(j,target)) break;
+            if (!firstTurn) firstTurn=nowMs()-j.start;
+            ++fixes; settle(j,target); previous={}; misses=0; edgeChecks=0; continue;
+        }
+        previous=f; previousPose=capture;
