+namespace {
+
+using Jpeg = std::unique_ptr<uint8_t, decltype(&heap_caps_free)>;
+
+bool wifiReady()
+{
+    auto* station = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t address{};
+    return station && esp_netif_is_netif_up(station) &&
+           esp_netif_get_ip_info(station, &address) == ESP_OK && address.ip.addr != 0;
+}
+
+struct Reply {
+    std::string body;
+    int retrySeconds = 0;
+};
+
+esp_err_t collectReply(esp_http_client_event_t* event)
+{
+    auto& reply = *static_cast<Reply*>(event->user_data);
+    if (event->event_id == HTTP_EVENT_ON_HEADER && event->header_key && event->header_value &&
+        strcasecmp(event->header_key, "Retry-After") == 0) {
+        const char* value = event->header_value;
+        if (value[0] >= '1' && value[0] <= '9' && value[1] == '\0') {
+            reply.retrySeconds = value[0] - '0';
+        }
+    }
+    if (event->event_id != HTTP_EVENT_ON_DATA) return ESP_OK;
+    if (event->data_len < 0 || reply.body.size() + event->data_len > 1024) return ESP_FAIL;
+    reply.body.append(static_cast<const char*>(event->data), event->data_len);
+    return ESP_OK;
+}
+
+bool inRange(const cJSON* value, int low, int high)
+{
+    return cJSON_IsNumber(value) && value->valuedouble == value->valueint &&
+           value->valueint >= low && value->valueint <= high;
+}
+
+bool validCommandId(const char* id)
+{
+    if (!id || strlen(id) != 36) return false;
+    return std::string(id).find_first_not_of("0123456789abcdef-") == std::string::npos;
+}
+
+bool execute(const cJSON* body, Jpeg& jpeg, size_t& length, int64_t& liveUntil)
+{
+    const char* actionText = cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(body, "action"));
+    if (!actionText) return false;
+    const std::string action(actionText);
+    if (action == "head") {
+        const auto* yaw = cJSON_GetObjectItemCaseSensitive(body, "yaw");
+        const auto* pitch = cJSON_GetObjectItemCaseSensitive(body, "pitch");
+        if (!inRange(yaw, -45, 45) || !inRange(pitch, 0, 45)) return false;
+        LvglLockGuard lock;
+        auto& motion = GetStackChan().motion();
+        if (motion.isModifyLocked()) return false;
+        motion.yawServo().moveWithSpeed(yaw->valueint * 10, 150);
+        motion.pitchServo().moveWithSpeed(pitch->valueint * 10, 150);
+        return true;
+    }
+
+    auto& board = Board::GetInstance();
+    if (action == "volume" || action == "brightness") {
+        const auto* value = cJSON_GetObjectItemCaseSensitive(body, "value");
+        if (!inRange(value, 0, 100)) return false;
+        if (action == "volume") {
+            if (auto* codec = board.GetAudioCodec()) {
+                codec->SetOutputVolume(value->valueint);
+                return true;
+            }
+        } else if (auto* backlight = board.GetBacklight()) {
+            backlight->SetBrightness(value->valueint, true);
+            return true;
+        }
+        return false;
+    }
+
+    if (action != "photo" && action != "streamStart" && action != "frame") return false;
+    if (Application::GetInstance().GetDeviceState() != kDeviceStateIdle) {
+        liveUntil = 0;
+        return false;
+    }
+    if (action == "frame" && esp_timer_get_time() > liveUntil) return false;
+    auto* camera = hal_bridge::board_get_camera();
+    if (!camera) return false;
+
+    const bool live = action != "photo";
+    auto* display = dynamic_cast<StackChanAvatarDisplay*>(board.GetDisplay());
+    if (!display || !display->ShowCompanionCameraIndicator(live)) return false;
+    uint8_t* raw = nullptr;
+    const int64_t captureStarted = esp_timer_get_time();
+    const bool ok = camera->TakeCompanionJpeg(action == "photo", live ? 35 : 80, &raw, &length);
+    jpeg.reset(raw);
+    if (live) liveUntil = ok ? captureStarted + 3500000 : 0;
+    return ok && jpeg && length && length <= 768 * 1024;
+}
+
+void run(void*)
+{
+    const auto deviceId = SystemInfo::GetMacAddress();
+    for (;;) {
+        if (!wifiReady()) {
+            vTaskDelay(pdMS_TO_TICKS(1500));
+            continue;
+        }
+        const auto root = Settings("companion", false).GetString("url");
+        const auto token = Settings("websocket", false).GetString("token");
+        if (root.rfind("https://", 0) != 0 || root.find_first_of("?#") != std::string::npos || token.empty()) {
+            vTaskDelay(pdMS_TO_TICKS(5000));
+            continue;
+        }
+        const std::string poll = root + "/poll";
+        const std::string result = root + "/result";
+        const std::string auth = "Bearer " + token;
+        Reply reply;
+        esp_http_client_config_t config{};
+        config.url = poll.c_str();
+        config.timeout_ms = 9500;
+        config.disable_auto_redirect = true;
+        config.crt_bundle_attach = esp_crt_bundle_attach;
+        config.event_handler = collectReply;
+        config.user_data = &reply;
+        auto client = esp_http_client_init(&config);
+        if (!client) {
+            vTaskDelay(pdMS_TO_TICKS(3000));
+            continue;
+        }
+        esp_http_client_set_header(client, "Authorization", auth.c_str());
+        esp_http_client_set_header(client, "Device-Id", deviceId.c_str());
+
+        int64_t liveUntil = 0;
+        while (wifiReady()) {
+            reply = {};
+            esp_http_client_set_url(client, poll.c_str());
+            esp_http_client_set_post_field(client, nullptr, 0);
+            esp_http_client_set_method(client, HTTP_METHOD_GET);
+            esp_http_client_delete_header(client, "X-Command-Id");
+            esp_http_client_delete_header(client, "X-Command-Result");
+            esp_http_client_delete_header(client, "Content-Type");
+            if (esp_http_client_perform(client) != ESP_OK) break;
+            const int status = esp_http_client_get_status_code(client);
+            if (status == 204) {
+                const auto now = esp_timer_get_time();
+                if (reply.retrySeconds) {
+                    vTaskDelay(pdMS_TO_TICKS(now < liveUntil ? 180 : reply.retrySeconds * 1000));
+                }
+                continue;
+            }
+            if (status != 200) break;
+            const auto command = std::unique_ptr<cJSON, decltype(&cJSON_Delete)>(
+                cJSON_Parse(reply.body.c_str()), cJSON_Delete);
+            const char* id = cJSON_GetStringValue(cJSON_GetObjectItemCaseSensitive(command.get(), "id"));
+            if (!validCommandId(id)) break;
+
+            Jpeg jpeg(nullptr, heap_caps_free);
+            size_t length = 0;
+            const bool ok = execute(command.get(), jpeg, length, liveUntil);
+            if (!ok) length = 0;
+            reply = {};
+            esp_http_client_set_url(client, result.c_str());
+            esp_http_client_set_method(client, HTTP_METHOD_POST);
+            esp_http_client_set_header(client, "X-Command-Id", id);
+            esp_http_client_set_header(client, "X-Command-Result", ok ? "ok" : "error");
+            esp_http_client_set_header(client, "Content-Type", length ? "image/jpeg" : "application/octet-stream");
+            esp_http_client_set_post_field(client, length ? reinterpret_cast<const char*>(jpeg.get()) : "", length);
+            const auto sent = esp_http_client_perform(client);
+            esp_http_client_set_post_field(client, nullptr, 0);
+            if (sent != ESP_OK) break;
+        }
+        esp_http_client_cleanup(client);
+        vTaskDelay(pdMS_TO_TICKS(2500));
+    }
+}
+
+}  // namespace
+
+void startCompanionRelay()
+{
+    xTaskCreate(run, "companion", 10 * 1024, nullptr, 2, nullptr);
+}
