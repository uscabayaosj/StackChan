+
+bool StackChanCamera::TakeCompanionJpeg(bool preview, int quality, uint8_t** out, size_t* length)
+{
+    auto lock = LockCapture();
+    // Preserve a pending voice photo while the companion takes its own frame.
+    const auto original = frame_;
+    frame_.data = nullptr;
+    const bool captured = CaptureFrame(preview);
+    const bool encoded = captured && frame_.data &&
+        image_to_jpeg(frame_.data, frame_.len, frame_.width, frame_.height,
+                      frame_.format, quality, out, length);
+    heap_caps_free(frame_.data);
+    frame_ = original;
+    return encoded;
+}
