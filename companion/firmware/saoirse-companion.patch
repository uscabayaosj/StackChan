+bool StackChanAvatarDisplay::ShowCompanionCameraIndicator(bool live)
+{
+    DisplayLockGuard lock(this);
+    if (!setup_ui_called_) return false;
+    if (!companion_camera_indicator_) {
+        companion_camera_indicator_ = lv_label_create(lv_layer_top());
+        if (!companion_camera_indicator_) return false;
+        lv_obj_align(companion_camera_indicator_, LV_ALIGN_TOP_RIGHT, -6, 6);
+        lv_obj_set_style_bg_color(companion_camera_indicator_, lv_color_hex(0x9C172D), 0);
+        lv_obj_set_style_bg_opa(companion_camera_indicator_, LV_OPA_COVER, 0);
+        lv_obj_set_style_text_color(companion_camera_indicator_, lv_color_hex(0xFFFFFF), 0);
+        lv_obj_set_style_pad_all(companion_camera_indicator_, 4, 0);
+        lv_obj_set_style_radius(companion_camera_indicator_, 5, 0);
+    }
+    if (!companion_camera_timer_) {
+        companion_camera_timer_ = lv_timer_create([](lv_timer_t* timer) {
+            auto* display = static_cast<StackChanAvatarDisplay*>(lv_timer_get_user_data(timer));
+            lv_obj_add_flag(display->companion_camera_indicator_, LV_OBJ_FLAG_HIDDEN);
+            lv_timer_pause(timer);
+        }, 3500, this);
+        if (!companion_camera_timer_) {
+            lv_obj_add_flag(companion_camera_indicator_, LV_OBJ_FLAG_HIDDEN);
+            return false;
+        }
+    }
+    lv_label_set_text(companion_camera_indicator_, live ? "Remote camera live" : "Remote photo");
+    lv_obj_remove_flag(companion_camera_indicator_, LV_OBJ_FLAG_HIDDEN);
+    lv_timer_reset(companion_camera_timer_);
+    lv_timer_resume(companion_camera_timer_);
+    return true;
 }
 
