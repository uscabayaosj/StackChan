+#include "env_iii.h"
+
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <driver/i2c_master.h>
+#include <esp_log.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+namespace env_iii {
+namespace {
+
+constexpr char tag[] = "ENV-III";
+constexpr uint8_t sht30_address = 0x44;
+constexpr uint8_t qmp6988_address = 0x70;
+constexpr uint8_t qmp6988_chip_id = 0x5c;
+constexpr int timeout_ms = 20;
+std::atomic_bool port_a_in_use{false};
+
+// Use the external controller for the duration of a reading. The board's
+// display, touch and audio peripherals use the other I2C controller.
+struct PortA {
+    i2c_master_bus_handle_t bus{};
+    i2c_master_dev_handle_t humidity{};
+    i2c_master_dev_handle_t pressure{};
+
+    ~PortA()
+    {
+        if (humidity) i2c_master_bus_rm_device(humidity);
+        if (pressure) i2c_master_bus_rm_device(pressure);
+        if (bus) i2c_del_master_bus(bus);
+    }
+
+    bool open()
+    {
+        const i2c_master_bus_config_t config{
+            .i2c_port = I2C_NUM_0,
+            .sda_io_num = GPIO_NUM_2,
+            .scl_io_num = GPIO_NUM_1,
+            .clk_source = I2C_CLK_SRC_DEFAULT,
+            .glitch_ignore_cnt = 7,
+            .flags = {.enable_internal_pullup = true},
+        };
+        return i2c_new_master_bus(&config, &bus) == ESP_OK;
+    }
+
+    bool add_device(uint8_t address, i2c_master_dev_handle_t& device) const
+    {
+        const i2c_device_config_t config{
+            .dev_addr_length = I2C_ADDR_BIT_LEN_7,
+            .device_address = address,
+            .scl_speed_hz = 100000,
+        };
+        return i2c_master_bus_add_device(bus, &config, &device) == ESP_OK;
+    }
+};
+
+bool read_registers(i2c_master_dev_handle_t device, uint8_t reg, uint8_t* data, size_t size)
+{
+    return i2c_master_transmit_receive(device, &reg, 1, data, size, timeout_ms) == ESP_OK;
+}
+
+int unsigned_word(const uint8_t* data)
+{
+    return (int(data[0]) << 8) | data[1];
+}
+
+bool valid_sht30_crc(const uint8_t* word)
+{
+    uint8_t crc = 0xff;
+    for (int byte = 0; byte < 2; ++byte) {
+        crc ^= word[byte];
+        for (int bit = 0; bit < 8; ++bit) {
+            crc = static_cast<uint8_t>((crc << 1) ^ ((crc & 0x80) ? 0x31 : 0));
+        }
+    }
+    return crc == word[2];
+}
+
+void read_sht30(i2c_master_dev_handle_t device, Reading& reading)
+{
+    uint8_t data[6];
+    if (i2c_master_receive(device, data, sizeof(data), timeout_ms) != ESP_OK) return;
+    if (valid_sht30_crc(data)) {
+        reading.temperature_c = -45.0f + 175.0f * unsigned_word(data) / 65535.0f;
+    }
+    if (valid_sht30_crc(data + 3)) {
+        reading.relative_humidity_percent = 100.0f * unsigned_word(data + 3) / 65535.0f;
+    }
+}
+
+int read_signed_coefficient(int value, int bits)
+{
+    const int sign_bit = 1 << (bits - 1);
+    return (value ^ sign_bit) - sign_bit;
+}
+
+int raw_qmp6988_sample(const uint8_t* data)
+{
+    const int value = (int(data[0]) << 16) | (int(data[1]) << 8) | data[2];
+    return value - (1 << 23);
+}
+
+float compensate_pressure(const std::array<uint8_t, 25>& calibration, const uint8_t* sample)
+{
+    // The two 20-bit offsets share the final OTP byte. The other coefficients
+    // are signed 16-bit words, normalized from M5Stack's fixed-point form.
+    const auto coeff = [&](int index, double scale, double offset, int fractional_bits) {
+        const int otp = read_signed_coefficient(unsigned_word(calibration.data() + index), 16);
+        return std::ldexp(scale * otp + offset, -fractional_bits) / 32767.0;
+    };
+    const int packed_b00 = (unsigned_word(calibration.data()) << 4) | (calibration[24] >> 4);
+    const int packed_a0 = (unsigned_word(calibration.data() + 18) << 4) | (calibration[24] & 0x0f);
+    const double a0 = read_signed_coefficient(packed_a0, 20) / 16.0;
+    const double a1 = coeff(20, 3608, -1731677965, 23);
+    const double a2 = coeff(22, 16889, -87619360, 47);
+    const double b00 = read_signed_coefficient(packed_b00, 20) / 16.0;
+    const double bt1 = coeff(2, 2982, 107370906, 15);
+    const double bt2 = coeff(4, 329854, 108083093, 38);
+    const double bp1 = coeff(6, 19923, 1133836764, 20);
+    const double b11 = coeff(8, 2406, 118215883, 34);
+    const double bp2 = coeff(10, 3079, -181579595, 43);
+    const double b12 = coeff(12, 6846, 85590281, 53);
+    const double b21 = coeff(14, 13836, 79333336, 60);
+    const double bp3 = coeff(16, 2915, 157155561, 65);
+    const double raw_temperature = raw_qmp6988_sample(sample + 3);
+    const double raw_pressure = raw_qmp6988_sample(sample);
+
+    // The temperature term is in units of 1/256 °C. It compensates the
+    // barometer only. Air temperature comes from the separate SHT30.
+    const double temp = a0 + raw_temperature * (a1 + raw_temperature * a2);
+    const double pressure_pa = b00 + temp * (bt1 + temp * bt2) +
+        raw_pressure * (bp1 + temp * (b11 + temp * b12) +
+                        raw_pressure * (bp2 + temp * b21 + raw_pressure * bp3));
+    return static_cast<float>(pressure_pa / 100.0);
+}
+
+void read_qmp6988(i2c_master_dev_handle_t device, const std::array<uint8_t, 25>& calibration, Reading& reading)
+{
+    constexpr uint8_t measuring = 1 << 3;
+    for (int attempt = 0; attempt < 4; ++attempt) {
+        uint8_t status{};
+        if (!read_registers(device, 0xf3, &status, sizeof(status))) return;
+        if ((status & measuring) == 0) {
+            uint8_t data[6];
+            if (!read_registers(device, 0xf7, data, sizeof(data))) return;
+            const float hpa = compensate_pressure(calibration, data);
+            if (hpa >= 300.0f && hpa <= 1100.0f) reading.pressure_hpa = hpa;
+            return;
+        }
+        vTaskDelay(1);
+    }
+}
+
+}  // namespace
+
+bool uses_port_a()
+{
+    return port_a_in_use.load();
+}
+
+Reading read()
+{
+    Reading reading;
+    PortA port;
+    uint8_t chip_id{};
+    if (!port.open() || i2c_master_probe(port.bus, qmp6988_address, timeout_ms) != ESP_OK ||
+        !port.add_device(qmp6988_address, port.pressure) ||
+        !read_registers(port.pressure, 0xd1, &chip_id, sizeof(chip_id)) || chip_id != qmp6988_chip_id) {
+        ESP_LOGI(tag, "QMP6988 unavailable on Port A; check the ENV III connection");
+        return reading;
+    }
+    port_a_in_use.store(true);
+
+    // Trigger both measurements before waiting for conversion. SHT30 uses
+    // high repeatability without clock stretching. QMP6988 uses forced mode
+    // with 1x temperature and 8x pressure oversampling, then returns to sleep.
+    constexpr uint8_t sht30_command[] = {0x24, 0x00};
+    const bool humidity_started = i2c_master_probe(port.bus, sht30_address, timeout_ms) == ESP_OK &&
+        port.add_device(sht30_address, port.humidity) &&
+        i2c_master_transmit(port.humidity, sht30_command, sizeof(sht30_command), timeout_ms) == ESP_OK;
+    constexpr uint8_t qmp6988_command[] = {0xf4, 0x31};
+    std::array<uint8_t, 25> calibration{};
+    const bool pressure_started = read_registers(port.pressure, 0xa0, calibration.data(), calibration.size()) &&
+        i2c_master_transmit(port.pressure, qmp6988_command, sizeof(qmp6988_command), timeout_ms) == ESP_OK;
+    if (humidity_started || pressure_started) vTaskDelay(pdMS_TO_TICKS(20) + 1);
+    if (humidity_started) read_sht30(port.humidity, reading);
+    if (pressure_started) read_qmp6988(port.pressure, calibration, reading);
+
+    ESP_LOGI(tag, "Port A sample: temperature_c=%.2f humidity_percent=%.2f pressure_hpa=%.2f",
+             reading.temperature_c.value_or(NAN), reading.relative_humidity_percent.value_or(NAN),
+             reading.pressure_hpa.value_or(NAN));
+    return reading;
+}
+
+}  // namespace env_iii
