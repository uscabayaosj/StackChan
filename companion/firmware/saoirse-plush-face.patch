+                    case Emotion::Happy: mouth = Smile; break;
+                    case Emotion::Sleepy: eyes = Blink; break;
+                    case Emotion::Angry: eyes = blinking ? Blink : AngryEyes; mouth = Frown; break;
+                    case Emotion::Sad:
