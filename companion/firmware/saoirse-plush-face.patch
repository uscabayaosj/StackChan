+                ESP_LOGI(kTag, "Speech animation closed=%d small=%d open=%d", !!(_speech_frames & 1),
+                         !!(_speech_frames & 2), !!(_speech_frames & 4));
+                _speech_frames = 0;
+            }
+            _activity = activity;
+            lv_label_set_text_static(_status, status);
+            ESP_LOGI(kTag, "%s", status);
+        }
+    }
