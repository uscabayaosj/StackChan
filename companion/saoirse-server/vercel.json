{
  "framework": null,
  "functions": {
    "api/ws.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/opusscript/build/**"
    },
    "api/ota.ts": {
      "maxDuration": 10
    },
    "api/vision.ts": {
      "maxDuration": 30
    },
    "api/companion.ts": {
      "maxDuration": 20
    }
  },
  "outputDirectory": "public",
  "installCommand": "npm install --omit=optional",
  "rewrites": [
    {
      "source": "/api/companion/:route*",
      "destination": "/api/companion?route=:route*"
    }
  ],
  "regions": [
    "fra1"
  ]
}
