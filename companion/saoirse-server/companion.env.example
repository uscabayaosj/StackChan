# Relay process and persistent storage
BIND_ADDRESS=127.0.0.1
PORT=8765
PUBLIC_WS_URL=wss://saoirse.example.com/api/ws
COMPANION_DB=/var/lib/saoirse/companion.sqlite
# Set this instead of COMPANION_DB for the Vercel and Neon deployment.
# COMPANION_DATABASE_URL=
COMPANION_DEVICE_ID=aa:bb:cc:dd:ee:ff
COMPANION_TOKEN=
SAOIRSE_DEVICE_TOKEN=
OTA_SECRET=

# Use the existing Saoirse provider settings
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-oss-20b
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEVICE_TZ=Europe/London

# Optional secondary backend
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_MODEL=
