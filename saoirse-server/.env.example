LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_PROVIDER_ORDER=groq
LLM_MAX_TOKENS=400
# Reasoning effort sent to OpenRouter (low|medium|high); 'none' disables the field entirely
LLM_REASONING_EFFORT=low
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-flash
# LLM_FALLBACK_MAX_TOKENS=400
# Fallback default is 'none': no reasoning field is sent, because DeepSeek and other OpenAI-compatible APIs
# may reject OpenRouter's unknown 'reasoning' field with a non-retryable 400. Set low|medium|high only for OpenRouter-style backends.
# LLM_FALLBACK_REASONING_EFFORT=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
# Bearer token the robot must send to /api/ws. Empty = auth off (local dev only; the server warns at startup).
# Required on Vercel: loadConfig throws when VERCEL is set and this is empty.
SAOIRSE_DEVICE_TOKEN=
# Shared secret the robot appends to CONFIG_OTA_URL as ?k=... ; the OTA reply carries the device token, so set this in production.
OTA_SECRET=
# Local dev uses ws://<lan-ip>:8765/api/ws; in production this MUST be the deployment's wss://<host>/api/ws
PUBLIC_WS_URL=ws://192.168.1.10:8765/api/ws
VAD_RMS_THRESHOLD=0.025
VAD_SILENCE_MS=1200
IDLE_CLOSE_MS=60000
# Deadlines (ms): one STT request, the whole LLM stream (primary + fallback), and each TTS sentence.
# A timeout ends the turn with a logged "process error" (and a tts stop if speech had started).
STT_TIMEOUT_MS=10000
LLM_TIMEOUT_MS=15000
TTS_TIMEOUT_MS=10000
# The robot's IANA time zone: OTA timezone_offset (the robot's clock) and "Current local time" in the prompt.
# The robot's IANA time zone (code default: UTC)
DEVICE_TZ=Europe/London
# Opus codec: wasm (default, safe) or native (faster, but @discordjs/opus has segfaulted on quiet audio on macOS arm64)
# OPUS_CODEC=wasm         # default; 'native' uses @discordjs/opus (segfaulted on quiet audio on macOS arm64)

# Robot tools (camera, head, lights) and the vision model behind the camera.
# DEVICE_TOOLS=self.camera.take_photo,self.robot.set_head_angles,self.robot.get_head_angles,self.robot.set_led_color
# VISION_MODEL=google/gemini-3.5-flash-lite
# VISION_API_KEY=            # defaults to LLM_API_KEY
# VISION_BASE_URL=           # defaults to LLM_BASE_URL
# PUBLIC_VISION_URL=         # defaults to PUBLIC_WS_URL with /api/vision
